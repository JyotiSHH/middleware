# Shopify order store (read-only app, client credentials grant)
SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Stable GraphQL Admin API version, e.g. 2026-10
SHOPIFY_API_VERSION=

# Status API
STATUS_API_BASE=
STATUS_API_KEY=

# Shared key for the admin endpoint GET /api/orders/:orderNumber (x-api-key header).
# Server-to-server only - never ship this to a browser. Leave empty to disable
# that endpoint (it then returns 500 CONFIG_ERROR); /api/track is unaffected.
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_API_KEY=

# Note: /api/track is public (Access-Control-Allow-Origin: *), so there is no
# origin allow-list. /api/orders/:orderNumber stays locked behind ADMIN_API_KEY.

# Optional timeouts in ms (defaults: 5000 / 7000)
SHOPIFY_TIMEOUT_MS=
STATUS_TIMEOUT_MS=
